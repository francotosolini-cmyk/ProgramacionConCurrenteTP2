@startuml Diagrama de Secuencia - Disparo de Transición

skinparam dpi 150

title Diagrama de Secuencia - Disparo de una transición en el Monitor (con ControlTemporal, Política y paso de testigo)

autonumber
actor "Worker (Hilo)" as W
participant "Monitor" as M
participant "Mutex" as X
participant "RedPetri" as R
participant "ControlTemporal" as T
participant "Politica" as P
participant "Colas" as C
participant "Logger" as L

== Disparo en el Monitor ==
W -> M : fireTransition(t)
M -> X : adquirir()
X --> M

loop Reintenta hasta disparar t o hasta que la red finalice
    M -> R : isFinished()
    R --> M : finalizada?

    alt Caso 0: la red ya finalizó
        M -> X : liberar()
        M --> W : false
        note right of W : El Worker termina su run()

    else La red sigue en ejecución
        M -> R : isSensitised(t)
        R --> M : sensibilizadaRed?
        M -> T : hayAlguienEsperandoVentana(t)
        T --> M : ocupada?
        note over M : sensibilizada = sensibilizadaRed && !ocupada

        alt Caso A: sensibilizada == true
            M -> T : evaluarVentanaTemporal(t)
            T --> M : ventana (NO_TEMPORAL | ANTES_DE_VENTANA | DENTRO_DE_VENTANA)

            alt Caso A1: ventana == ANTES_DE_VENTANA
                M -> T : tiempoEspera(t)
                T --> M : esperaMs
                M -> T : setEsperandoVentana(t)
                M -> X : liberar()
                M -> T : dormir(esperaMs)
                note over M, T
                    Thread.sleep(esperaMs) fuera del mutex:
                    otros hilos pueden avanzar mientras espera α.
                end note
                T --> M : interrumpido?
                M -> X : adquirir()
                X --> M
                M -> T : limpiarEsperandoVentana(t)

                alt interrumpido == true
                    M -> X : liberar()
                    M --> W : false
                    note right of W : El Worker conserva el flag interrupt y termina
                else no interrumpido
                    note over M
                        Vuelve al inicio del loop (continue) y reevalúa
                        si t sigue sensibilizada y ya abrió la ventana.
                    end note
                end

            else Caso A2: NO_TEMPORAL o DENTRO_DE_VENTANA (dispara)
                M -> R : getSensitisedTransitions()
                R --> M : antes[]
                M -> R : fire(t)
                note right of R
                    Actualiza el marcado y verifica los
                    invariantes de plaza (Req. 12).
                end note
                R --> M : true
                M -> R : getSensitisedTransitions()
                R --> M : despues[]
                M -> T : actualizarTimestamps(antes[], despues[], t)
                M -> L : logTransition(t)
                note right of L : Escribe "T<t> <timestamp>" en el log

                M -> R : isFinished()
                R --> M : finalizada?

                alt Caso A2a: con este disparo la red finalizó (T9 llegó a 200)
                    M -> C : despertarTodos()
                    note over M, C
                        Abre todas las colas para que los hilos
                        dormidos salgan y terminen.
                    end note
                    M -> X : liberar()
                else Caso A2b: la red sigue
                    group signalNext() [paso de testigo o liberación]
                        M -> R : getSensitisedTransitions()
                        R --> M : sensibilizadas[]
                        M -> T : hayAlguienEsperandoVentana(i)
                        T --> M : ocupada[]
                        note over M
                            wakeable[i] = esperando[i] > 0
                                && sensibilizadas[i] && !ocupada[i]
                        end note
                        alt Hay al menos un hilo despertable
                            M -> P : elegir(wakeable[])
                            note right of P
                                RandomPolicy: sortea uniformemente.
                                PriorityPolicy: si la prioritaria es candidata,
                                la elige siempre; si no, delega en RandomPolicy.
                                Main configura T4 como prioritaria.
                            end note
                            P --> M : elegida
                            M -> M : esperando[elegida]--
                            M -> C : despertar(elegida)
                            note over M, C
                                El mutex NO se libera: pasa directo
                                al hilo despertado (paso de testigo).
                            end note
                        else No hay hilos despertables
                            M -> X : liberar()
                        end
                    end
                end
                M --> W : true (disparo completado)
            end

        else Caso B: sensibilizada == false (no sensibilizada o ventana ocupada)
            M -> M : esperando[t]++
            M -> X : liberar()
            M -> C : esperar(t)
            note over W, C
                El hilo queda bloqueado en la cola de t hasta que
                otro hilo ejecute signalNext() o despertarTodos().
            end note
            ... Tiempo después ...
            C --> M : despertado

            M -> R : isFinished()
            R --> M : finalizada?

            alt Caso B1: la red finalizó (lo despertó despertarTodos())
                M --> W : false (sale sin tomar el mutex)
                note right of W : El Worker termina su run()
            else Caso B2: lo despertó signalNext()
                note over M
                    El hilo ya tiene el mutex (paso de testigo).
                    Vuelve al inicio del loop y reevalúa t.
                end note
            end
        end
    end
end

@enduml
